{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Inventory stock record for finished garments and raw tailoring materials",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "size": { "type": "string" },
        "color": { "type": "string" },
        "unit": { "type": "string" },
        "stockOnHand": { "type": "number" },
        "stockReserved": { "type": "number" },
        "reorderLevel": { "type": "number" },
        "unitCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "location": { "type": "string" },
        "supplier": { "type": "string" },
        "lastRestockedDate": { "type": "string" },
        "status": { "type": "string" },
        "productId": { "type": "string" },
        "published": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "sku", "name", "category", "stockOnHand", "unitCost", "sellingPrice"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for admin staff or store customers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "photoURL": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/inventory/{inventoryId}": {
      "schema": "InventoryItem",
      "description": "Real-time enterprise uniform and raw materials inventory synchronized with Firestore"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered user profiles for staff and customers"
    }
  }
}
